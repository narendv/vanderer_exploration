/data/*
!/data/.gitkeep

# Data splits: keep the trajectory lists, not caches or links to shared data
train/vint_train/data/data_splits/**
!train/vint_train/data/data_splits/**/
!train/vint_train/data/data_splits/**/traj_names.txt

# Run outputs
train/logs/
train/wandb/
wandb/
